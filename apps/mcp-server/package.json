{
  "name": "@docform/mcp-server",
  "version": "0.3.1",
  "description": "Local MCP server for DocForm document generation.",
  "type": "module",
  "license": "Apache-2.0",
  "main": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "development": "./src/index.ts",
      "import": "./dist/index.js"
    }
  },
  "bin": {
    "docform-mcp": "./dist/index.js"
  },
  "scripts": {
    "build": "tsup src/index.ts --format esm --dts --clean",
    "dev": "node --conditions development --import tsx src/index.ts",
    "test": "vitest run"
  },
  "dependencies": {
    "@docform/core": "workspace:*",
    "@modelcontextprotocol/sdk": "^1.29.0",
    "zod": "^4.4.1"
  }
}
