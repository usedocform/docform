{
  "name": "@docform/api",
  "version": "0.5.0",
  "description": "Local REST API for DocForm document generation.",
  "type": "module",
  "license": "Apache-2.0",
  "main": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "development": "./src/index.ts",
      "import": "./dist/index.js"
    }
  },
  "scripts": {
    "build": "tsup src/index.ts src/worker.ts --format esm --dts --clean",
    "dev": "node --conditions development --import tsx src/index.ts",
    "worker": "node --conditions development --import tsx src/worker.ts",
    "test": "vitest run"
  },
  "dependencies": {
    "@aws-sdk/client-s3": "^3.1041.0",
    "@aws-sdk/s3-request-presigner": "^3.1041.0",
    "@docform/core": "workspace:*",
    "bullmq": "^5.76.5",
    "fastify": "^5.8.5",
    "ioredis": "^5.10.1"
  }
}
