{
  "name": "@docform/api",
  "version": "0.2.0",
  "description": "Local REST API for DocForm document generation.",
  "type": "module",
  "license": "Apache-2.0",
  "main": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "development": "./src/index.ts",
      "import": "./dist/index.js"
    }
  },
  "scripts": {
    "build": "tsup src/index.ts --format esm --dts --clean",
    "dev": "node --conditions development --import tsx src/index.ts",
    "test": "vitest run"
  },
  "dependencies": {
    "@docform/core": "workspace:*",
    "fastify": "^5.8.5"
  }
}
