{
  "name": "@docform/cli",
  "version": "0.1.1",
  "description": "Command-line interface for generating PDF documents with DocForm.",
  "type": "module",
  "keywords": [
    "docform",
    "cli",
    "pdf",
    "markdown",
    "document-generation"
  ],
  "bin": {
    "docform": "./dist/index.js"
  },
  "scripts": {
    "build": "tsup src/index.ts --format esm --dts --clean",
    "dev": "node --conditions development --import tsx src/index.ts"
  },
  "dependencies": {
    "@docform/ai": "workspace:^0.2.0",
    "@docform/core": "workspace:*"
  },
  "devDependencies": {}
}
