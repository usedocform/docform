{
  "name": "@docform/cli",
  "version": "0.3.2",
  "description": "Command-line interface for generating PDF and DOCX documents with DocForm.",
  "type": "module",
  "license": "Apache-2.0",
  "keywords": [
    "docform",
    "cli",
    "pdf",
    "markdown",
    "document-generation"
  ],
  "bin": {
    "docform": "./dist/index.js"
  },
  "scripts": {
    "build": "tsup src/index.ts --format esm --dts --clean",
    "dev": "node --conditions development --import tsx src/index.ts"
  },
  "dependencies": {
    "@docform/ai": "workspace:^0.2.0",
    "@docform/api": "workspace:*",
    "@docform/core": "workspace:*",
    "@docform/mcp-server": "workspace:*"
  }
}
